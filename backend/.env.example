# Names only, with placeholders. Copy to backend/.env (gitignored) and fill in local values.
MATCHDESK_ENV=dev
MATCHDESK_DATABASE_URL=postgresql+psycopg://matchdesk_app@localhost:5432/matchdesk_dev
MATCHDESK_MIGRATION_DATABASE_URL=postgresql+psycopg://<owner>@localhost:5432/matchdesk_dev
MATCHDESK_API_PORT=8101
MATCHDESK_LOG_LEVEL=INFO
# Proxies whose X-Forwarded-For is believed (comma-separated addresses or CIDR ranges); empty = none.
MATCHDESK_TRUSTED_PROXIES=
MATCHDESK_APP_BASE_URL=http://127.0.0.1:5173
# Secrets: generate locally; never commit.
MATCHDESK_SESSION_KEY=<random, at least 32 bytes, url-safe>
MATCHDESK_TOKEN_KEY=<base64 of 32 random bytes>
MATCHDESK_TOKEN_KEY_ID=k1
# Files: local | s3
MATCHDESK_BLOB_BACKEND=s3
MATCHDESK_BLOB_ROOT=var/blobs
MATCHDESK_S3_ENDPOINT_URL=http://127.0.0.1:9000
MATCHDESK_S3_REGION=us-east-1
MATCHDESK_S3_BUCKET=matchdesk-dev
MATCHDESK_S3_ACCESS_KEY=<access key>
MATCHDESK_S3_SECRET_KEY=<secret key>
# Mail: Mailpit locally (no auth); a provider's SMTP endpoint in production.
MATCHDESK_SMTP_HOST=127.0.0.1
MATCHDESK_SMTP_PORT=1025
MATCHDESK_SMTP_STARTTLS=false
MATCHDESK_SMTP_USERNAME=
MATCHDESK_SMTP_PASSWORD=
MATCHDESK_MAIL_FROM=MatchDesk <no-reply@matchdesk.invalid>
