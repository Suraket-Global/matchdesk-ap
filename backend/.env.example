# Names only; local development uses trust authentication and needs no secret.
MATCHDESK_ENV=dev
MATCHDESK_DATABASE_URL=postgresql+psycopg://matchdesk_app@localhost:5432/matchdesk_dev
MATCHDESK_MIGRATION_DATABASE_URL=postgresql+psycopg://<owner>@localhost:5432/matchdesk_dev
MATCHDESK_API_PORT=8101
MATCHDESK_BLOB_ROOT=var/blobs
MATCHDESK_LOG_LEVEL=INFO
