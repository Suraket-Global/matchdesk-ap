# B18: names and placeholders only. The real file is /opt/matchdesk/.env on the server (mode 600,
# owner root), written by deploy/gen-env.sh with values from `openssl rand` generated on the server.
# Never commit it, never copy it off the server.

# Image tag (the commit the images were built from); change it to roll forward or back.
MATCHDESK_TAG=<git commit, short>

# Public origin of the web app. Until B19 the SSH tunnel address; B19: https://app.<domain>
MATCHDESK_APP_BASE_URL=http://127.0.0.1:8202

# Database: table owner (migrations, backups) and the application role (row-level security).
MATCHDESK_OWNER_DB_PASSWORD=<openssl rand -hex 32>
MATCHDESK_APP_DB_PASSWORD=<openssl rand -hex 32>

# Application secrets.
MATCHDESK_SESSION_KEY=<openssl rand -base64 48, url-safe>
MATCHDESK_TOKEN_KEY=<openssl rand -base64 32>
MATCHDESK_TOKEN_KEY_ID=k1
MATCHDESK_INBOUND_SIGNING_KEY=<openssl rand -hex 32>

# Backup encryption (deploy/backup.sh). Keep a copy of this key somewhere other than the server,
# or the backups cannot be restored after losing the server.
MATCHDESK_BACKUP_KEY=<openssl rand -base64 48>

# Mail: empty = the temporary Mailpit container. With the owner's SMTP account (Hostinger):
# MATCHDESK_SMTP_HOST=<smtp host>
# MATCHDESK_SMTP_PORT=587
# MATCHDESK_SMTP_STARTTLS=true
# MATCHDESK_SMTP_USERNAME=<mailbox>
# MATCHDESK_SMTP_PASSWORD=<mailbox password>
# MATCHDESK_MAIL_FROM=MatchDesk <no-reply@<domain>>
